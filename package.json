{
  "name": "whatinhere-mvp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all -p dev:web dev:api",
    "dev:web": "vite",
    "dev:api": "wrangler dev worker/src/index.ts --local --port 8787",
    "build": "vite build",
    "build:web": "vite build",
    "preview": "vite preview",
    "data:kiscon": "node scripts/fetch-kiscon.js",
    "data:railway": "node scripts/fetch-railway.js",
    "data:housing": "node scripts/fetch-housing.js",
    "data:urban-plan": "node scripts/fetch-urban-plan.js",
    "data:road": "node scripts/fetch-road.js",
    "data:building-permits": "node scripts/fetch-building-permits.js",
    "data:housing-approvals": "node scripts/fetch-housing-approvals.js",
    "data:committee-results": "node scripts/fetch-committee-results.js",
    "data:capital-construction": "node scripts/fetch-capital-construction.js",
    "data:capital-building-permits": "node scripts/fetch-capital-building-permits.js",
    "data:capital-housing-approvals": "node scripts/fetch-capital-housing-approvals.js",
    "data:capital-committee-results": "node scripts/fetch-capital-committee-results.js",
    "data:private-urban-plan": "node scripts/fetch-private-urban-plan.js",
    "data:eia": "node scripts/fetch-eia.js",
    "data:merge": "node scripts/merge-projects.js",
    "data:build": "npm-run-all data:kiscon data:railway data:housing data:urban-plan data:road data:building-permits data:housing-approvals data:committee-results data:capital-construction data:capital-building-permits data:capital-housing-approvals data:capital-committee-results data:private-urban-plan data:eia data:merge",
    "deploy:worker": "wrangler deploy",
    "db:migrate": "wrangler d1 execute whatinhere-db --file ./worker/src/db/schema.sql"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250303.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "wrangler": "^3.99.0"
  }
}
